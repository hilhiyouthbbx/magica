+// Pasted text color, kept only when it is readable on a white email.
+function pastedColor(css: string): string {
+  const m = /rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})/.exec(css || "");
