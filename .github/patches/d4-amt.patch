+  // Change the amount on a registration (e.g. a family paid $50 of a $310 registration).
+  // The old amount is written into the notes so there is always a trail of what it was.
+  async function saveAmount(c: Contact) {
+    if (!editAmt || editAmt.id !== c.id) return;
+    const n = Number(editAmt.val.replace(/[$,\s]/g, ""));
+    if (!isFinite(n) || n <= 0) { say("Enter an amount above $0.00 (for a free registration, use a 100% promo code instead).", true); return; }
+    const next = n.toFixed(2);
+    const prev = c.amountPaid ? Number(c.amountPaid).toFixed(2) : "";
+    if (next === prev) { setEditAmt(null); return; }
+    const trail = `Amount changed by admin: ${prev ? "$" + prev : "(blank)"} -> $${next} (${new Date().toLocaleDateString("en-US")})`;
+    const notes = c.notes ? `${c.notes} | ${trail}` : trail;
+    patchContact(c.id, { amountPaid: next, notes });
+    setEditAmt(null);
+    try { await save(c.id, { amountPaid: next, notes }); say(`Amount for ${c.camperName || c.name} is now $${next}.`); }
+    catch { patchContact(c.id, { amountPaid: c.amountPaid, notes: c.notes }); say("Couldn't save the new amount. Please try again.", true); }
+  }
+
   async function togglePaid(c: Contact) {
